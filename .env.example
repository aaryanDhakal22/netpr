# ---- Traefik (used by compose.yaml labels) ----
NETPR_HOST=print.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ---- Printer ----
# Canon imageCLASS LBP246dw; give it a DHCP reservation so the IP never changes.
# It only accepts encrypted IPP, served on port 443 (plain ipp:// gets "426
# Upgrade Required"). Typing just the IP into the Printer page's address test
# finds this form automatically. The Printer page can switch to another
# address; that overrides this until reset.
NETPR_PRINTER_URI=ipps://192.168.1.50:443/ipp/print

# ---- Auth ----
# Remote-User is only trusted from these source ranges. Use Traefik's container
# IP as a /32 if you pin it; otherwise the Traefik network's subnet:
#   docker network inspect traefik -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
NETPR_TRUSTED_PROXIES=172.18.0.0/16

# ---- Pushover (optional; set both or neither) ----
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ---- Tuning (defaults shown; the Printer page can override the print defaults) ----
# NETPR_MAX_UPLOAD_MB=50
# NETPR_CONFIRM_SHEETS=30
# NETPR_TONER_LOW_PCT=15
# NETPR_PAPER_SIZE=letter        # letter | a4, used for photos
# NETPR_STAGING_TTL=1h           # unprinted uploads are deleted after this
# NETPR_PRINTER_POLL=1m

# ---- Testing ----
# NETPR_DRY_RUN=true             # record jobs but never send them to the printer
# NETPR_DEV_USER=me              # LOCAL DEVELOPMENT ONLY: skips the Authelia header check
